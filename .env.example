# Base URL of the SQLite database. The dev container sets this to
# sqlite:////workspace/learnai.db; the app defaults to <repo>/learnai.db.
LEARN_AI_DATABASE_URL=sqlite:////workspace/learnai.db

# Comma-separated origins allowed to call the API directly.
LEARN_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
