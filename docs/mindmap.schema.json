{
  "$defs": {
    "LearnContent": {
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MindmapLink": {
      "properties": {
        "from": {
          "type": "string"
        },
        "fromSide": {
          "$ref": "#/$defs/Side"
        },
        "id": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "toSide": {
          "$ref": "#/$defs/Side"
        },
        "text": {
          "type": "string"
        },
        "arrow": {
          "$ref": "#/$defs/ArrowMode"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "fromSide",
        "toSide"
      ],
      "type": "object"
    },
    "MindmapNode": {
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "learn": {
          "$ref": "#/$defs/LearnContent",
          "default": {
            "blocks": []
          }
        },
        "quiz": {
          "$ref": "#/$defs/QuizContent",
          "default": {
            "questions": []
          }
        },
        "status": {
          "$ref": "#/$defs/NoteStatus",
          "default": "todo"
        },
        "width": {
          "format": "double",
          "type": "number"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "width"
      ],
      "type": "object"
    },
    "NoteStatus": {
      "enum": [
        "todo",
        "doing",
        "done"
      ],
      "type": "string"
    },
    "QuizContent": {
      "properties": {
        "questions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QuizQuestion"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "QuizQuestion": {
      "properties": {
        "answerIndex": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prompt": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "id",
        "options",
        "answerIndex"
      ],
      "type": "object"
    },
    "Side": {
      "enum": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "type": "string"
    },
    "ArrowMode": {
      "enum": [
        "none",
        "forward",
        "backward",
        "both"
      ],
      "type": "string"
    },
    "MindmapTextBox": {
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "x": {
          "format": "double",
          "type": "number"
        },
        "y": {
          "format": "double",
          "type": "number"
        },
        "width": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "x",
        "y",
        "width"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "createdAt": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/MindmapLink"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/MindmapNode"
      },
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "texts": {
      "items": {
        "$ref": "#/$defs/MindmapTextBox"
      },
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "nodes",
    "links",
    "id",
    "createdAt",
    "updatedAt"
  ],
  "title": "Mindmap document (v1)",
  "type": "object"
}
